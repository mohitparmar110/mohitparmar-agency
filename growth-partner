    <!-- JavaScript Logic -->
    <script>
        // --- 1. Particle Network Animation (Hero Canvas) ---
        const canvas = document.getElementById('hero-canvas');
        const ctx = canvas.getContext('2d');
        let width, height;
        let particles = [];

        function resize() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = document.querySelector('header').offsetHeight;
        }

        class Particle {
            constructor() {
                this.x = Math.random() * width;
                this.y = Math.random() * height;
                this.vx = (Math.random() - 0.5) * 0.5;
                this.vy = (Math.random() - 0.5) * 0.5;
                this.size = Math.random() * 2 + 1;
            }
            update() {
                this.x += this.vx;
                this.y += this.vy;
                if (this.x < 0 || this.x > width) this.vx *= -1;
                if (this.y < 0 || this.y > height) this.vy *= -1;
            }
            draw() {
                ctx.fillStyle = '#cbd5e1'; // Slate 300
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        function initParticles() {
            particles = [];
            const count = Math.min(Math.floor(window.innerWidth / 10), 100);
            for (let i = 0; i < count; i++) {
                particles.push(new Particle());
            }
        }

        function animate() {
            ctx.clearRect(0, 0, width, height);
            
            // Draw Connections
            ctx.strokeStyle = 'rgba(203, 213, 225, 0.3)'; // Slate lines
            ctx.lineWidth = 0.5;
            
            for (let i = 0; i < particles.length; i++) {
                let p1 = particles[i];
                p1.update();
                p1.draw();
                
                for (let j = i + 1; j < particles.length; j++) {
                    let p2 = particles[j];
                    const dx = p1.x - p2.x;
                    const dy = p1.y - p2.y;
                    const dist = Math.sqrt(dx * dx + dy * dy);
                    
                    if (dist < 150) {
                        ctx.beginPath();
                        ctx.moveTo(p1.x, p1.y);
                        ctx.lineTo(p2.x, p2.y);
                        ctx.stroke();
                    }
                }
            }
            requestAnimationFrame(animate);
        }

        window.addEventListener('resize', () => { resize(); initParticles(); });
        resize();
        initParticles();
        animate();


        // --- 2. Calculator Logic & Chart.js ---
        const ltvInput = document.getElementById('ltv');
        const keywordsInput = document.getElementById('keywords');
        const keywordsVal = document.getElementById('keywords-val');
        const convInput = document.getElementById('conv-rate');
        const convVal = document.getElementById('conv-val');
        const potentialRevDisplay = document.getElementById('potential-rev');
        const annualLossDisplay = document.getElementById('annual-loss');

        // Chart Initialization
        const ctxChart = document.getElementById('opportunityChart').getContext('2d');
        let oppChart = new Chart(ctxChart, {
            type: 'bar',
            data: {
                labels: ['Current (Manual SEO)', 'Potential (Programmatic)'],
                datasets: [{
                    label: 'Monthly Revenue ($)',
                    data: [0, 0],
                    backgroundColor: ['#cbd5e1', '#0ea5e9'], // Slate vs Brand Blue
                    borderRadius: 8,
                    barThickness: 50
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return '$' + context.raw.toLocaleString();
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: '#f1f5f9' },
                        ticks: {
                            callback: function(value) { return '$' + value/1000 + 'k'; }
                        }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        function updateCalculator() {
            // Get Values
            const ltv = parseFloat(ltvInput.value) || 0;
            const keywords = parseInt(keywordsInput.value) || 0;
            const convRate = parseFloat(convInput.value) || 0;

            // Update UI Labels
            keywordsVal.innerText = keywords;
            convVal.innerText = convRate;

            // Calculations
            // Assumption: 10 visits per programmatic page per month (conservative)
            const trafficPerKey = 10; 
            const totalTraffic = keywords * trafficPerKey;
            
            // Monthly Revenue = Traffic * (ConvRate / 100) * LTV
            const monthlyRev = Math.round(totalTraffic * (convRate / 100) * ltv);
            const currentRev = Math.round(monthlyRev * 0.05); // Assume manual SEO captures 5% of potential

            // Annual Loss
            const annualLoss = (monthlyRev - currentRev) * 12;

            // Update Displays
            potentialRevDisplay.innerText = '$' + monthlyRev.toLocaleString();
            annualLossDisplay.innerText = '$' + annualLoss.toLocaleString();

            // Update Chart
            oppChart.data.datasets[0].data = [currentRev, monthlyRev];
            oppChart.update();
        }

        // Listeners
        [ltvInput, keywordsInput, convInput].forEach(el => {
            el.addEventListener('input', updateCalculator);
        });

        // Initial Run
        updateCalculator();

    </script>
